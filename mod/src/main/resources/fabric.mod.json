{
  "schemaVersion": 1,
  "id": "p2pmc",
  "version": "${version}",
  "name": "P2P Minecraft",
  "description": "Host a world for friends over a direct encrypted peer-to-peer connection: no VPN, no public IP, no VPS.",
  "authors": ["P2P Minecraft"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.p2pmc.mod.P2PMod"]
  },
  "mixins": [
    {
      "config": "p2pmc.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25"
  }
}
